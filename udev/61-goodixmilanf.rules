# Goodix Milan F fingerprint reader (27c6:5301) enumerates as a CDC-ACM
# "modem"; keep ModemManager from probing it with AT commands.
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="5301", ENV{ID_MM_DEVICE_IGNORE}="1"
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="5301", ENV{ID_MM_DEVICE_IGNORE}="1"
