+/*
+ * SIGFM ("SIFT Is Good For Matching") for small-area sensors.
+ * Based on the algorithm by Matthieu Charette, Natasha England-Elbro and
+ * Timur Mangliev (goodix-fp-linux-dev/libfprint, branch sigfm), LGPL-2.1+.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct GxSigfm GxSigfm;
+
+/* Extract SIFT keypoints/descriptors from an 8-bit grey image. */
+GxSigfm *gx_sigfm_extract (const unsigned char *pix, int width, int height);
+void     gx_sigfm_free (GxSigfm *info);
+int      gx_sigfm_keypoints (const GxSigfm *info);
+
+/* Geometric-consistency score of @probe against @enrolled; 0 = no match,
+ * < 0 = error. Counting stops once @cap is reached (cap <= 0: no cap). */
+int      gx_sigfm_score (const GxSigfm *probe, const GxSigfm *enrolled, int cap);
+
+/* Compact storage: u16 count, then per keypoint f32 x, f32 y, u8 desc[128]. */
+unsigned char *gx_sigfm_serialize (const GxSigfm *info, size_t *len);
+GxSigfm       *gx_sigfm_deserialize (const unsigned char *data, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
